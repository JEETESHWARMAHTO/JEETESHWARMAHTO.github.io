# --- Local dev (phase 1) ---
CONTACT_BOOK_DB=./data/contacts.db

# --- Supabase storage + auth (primary store when set) ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=service-role-key   server only, never exposed to the browser
# SUPABASE_ANON_KEY=anon-key              publishable, served to the browser via /api/config

# SUPABASE_ACCESS_TOKEN=pat_...      admin token for schema migrations (see scripts/)
# New columns: favorite boolean, group text, user_id uuid (per-user rows)
# - added via the Supabase Management API.

# --- Email/password auth (/api/auth/*) ---
# Enabled in Supabase with auto-confirm on (scripts/enable-email-auth.ps1):
# signup, login, refresh, logout, user routes call Supabase Auth with the
# anon key, so SUPABASE_ANON_KEY must be set for the API to work.
# Send Authorization: Bearer <access_token> to /api/contacts* to scope rows
# to the signed-in user; no token keeps the shared dev data.

# --- Google sign-in ---
# The Google provider is configured inside Supabase (see scripts/enable-google-auth.ps1).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
